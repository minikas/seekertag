{
  "name": "seekertag",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/patch-android-statusbar.cjs",
    "start": "npm run start --workspace=@seekertag/mobile --",
    "android": "npm run android --workspace=@seekertag/mobile --",
    "dev": "turbo run dev --env-mode=loose",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "api": "npm run start --workspace=seekertag-api --",
    "dev:lan": "node scripts/start-lan.mjs",
    "build:android": "node scripts/build-preview.mjs",
    "test:unit": "turbo run test --filter=@seekertag/mobile",
    "test:api": "turbo run test --filter=seekertag-api",
    "test:all": "npm run typecheck && npm test",
    "api:lan": "node scripts/start-lan.mjs --api-only",
    "test:android": "node scripts/test-android.mjs",
    "build:bundle": "turbo run build --filter=@seekertag/mobile",
    "build:escrow": "node scripts/build-escrow.mjs",
    "test:escrow": "npm run build:escrow && npm run test:escrow --workspace=seekertag-api",
    "api:devnet": "node --env-file-if-exists=apps/api/.env scripts/start-devnet-api.mjs",
    "test:devnet": "node scripts/test-devnet-rewards.mjs",
    "build": "turbo run build"
  },
  "devDependencies": {
    "turbo": "2.10.13",
    "@seekertag/shared": "*",
    "@solana/web3.js": "1.99.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
