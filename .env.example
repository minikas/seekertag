# Documentation template. Set real values privately in the server environment.
# No service credential is needed for local QR and conversation flows.
PUBLIC_URL=http://localhost:4318
PORT=4318
HOST=0.0.0.0

# Optional email. Enable only after PUBLIC_URL uses your permanent HTTPS domain
# and the sender domain has been verified with Resend.
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
NOTIFICATION_FROM=

# Native builds only: the same server, ending in /api.
# EXPO_PUBLIC_API_URL=https://your-real-domain/api
# NEVER prefix service keys with EXPO_PUBLIC_. Those values enter the app bundle.
