{
  "expo": {
    "name": "SeekerTag",
    "slug": "seekertag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#293D33",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.seekertag.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "SeekerTag",
      "shortName": "SeekerTag",
      "description": "Pequenas etiquetas. Grandes reencontros."
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o SeekerTag leia o QR da etiqueta.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Permita que o SeekerTag grave o link na sua etiqueta NFC."
        }
      ],
      [
        "./plugins/withAndroidCompatibility",
        {
          "allowCleartext": true
        }
      ]
    ],
    "scheme": "seekertag"
  }
}
