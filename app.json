{
  "expo": {
    "name": "SeekerTag",
    "slug": "seekertag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090910",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.seekertag.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "SeekerTag",
      "shortName": "SeekerTag",
      "description": "Etiquetas QR e conversas privadas para devolver objetos."
    },
    "plugins": [
      [
        "./plugins/withAndroidCompatibility",
        {
          "allowCleartext": true,
          "darkSplash": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o SeekerTag leia o QR da etiqueta.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Permita que o SeekerTag grave o link na sua etiqueta NFC."
        }
      ],
      "expo-system-ui",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090910",
          "image": "./assets/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#090910",
            "image": "./assets/icon.png"
          }
        }
      ]
    ],
    "scheme": "seekertag",
    "backgroundColor": "#090910"
  }
}
