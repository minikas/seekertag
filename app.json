{
  "expo": {
    "name": "SeekerTag",
    "slug": "seekertag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1615",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.seekertag.mobile"
    },
    "plugins": [
      [
        "./plugins/withAndroidCompatibility",
        {
          "allowCleartext": true,
          "darkSplash": true
        }
      ],
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "react-native-nfc-manager",
      "expo-system-ui",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1615",
          "image": "./assets/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0D1615",
            "image": "./assets/icon.png"
          }
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "seekertag",
    "backgroundColor": "#0D1615",
    "platforms": [
      "android"
    ]
  }
}
