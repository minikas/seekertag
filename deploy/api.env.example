# Public HTTPS origin used in QR/NFC links and OAuth callbacks.
PUBLIC_URL=https://api-seeker.viralizai.co

# SQLite is stored in the persistent Docker volume at /data.
DATABASE_PATH=/data/seekertag.sqlite

# Direct execution defaults to 0. The supplied Compose sets 1 for its private,
# single-Caddy ingress; do not publish the API port with that setting.
TRUST_PROXY_HOPS=0

# Optional OAuth providers. Keep actual credentials only in deploy/api.env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional Android push. Both values must be set to enable Firebase delivery.
# Use the Firebase project ID (not its numeric sender ID).
FIREBASE_PROJECT_ID=
# Private JSON mounted read-only by compose.production.yml.
# FIREBASE_SERVICE_ACCOUNT_FILE=/run/seekertag-firebase/service-account.json
FIREBASE_SERVICE_ACCOUNT_FILE=

# Leave blank until the reward verifier is provisioned securely on the server.
REWARD_VERIFIER_KEYPAIR=
REWARD_TREASURY=
REWARD_NETWORK=devnet
REWARD_RPC_URL=https://api.devnet.solana.com
REWARD_FEE_BPS=500
REWARD_LEGACY_VERIFIER_KEYPAIRS=
REWARD_TEST_USDC_MINT=
REWARD_TEST_SKR_MINT=
REWARDS_ALLOW_MAINNET=false
