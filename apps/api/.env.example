# Optional API settings. Provider secrets must never use EXPO_PUBLIC_*.
PORT=4318
PUBLIC_URL=http://localhost:4318

# Google OAuth client: Web application (the callback belongs to the API).
# Register https://YOUR-API-DOMAIN/api/auth/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Services ID associated with an eligible Sign in with Apple App ID.
# Register https://YOUR-API-DOMAIN/api/auth/oauth/apple/callback.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8 .p8 contents; quoted text with literal \n separators is supported.
APPLE_PRIVATE_KEY=

# Social providers require their complete settings and HTTPS PUBLIC_URL.
# Wallet sign-in also works with the USB/local API, without provider credentials.

# Reward escrow. Leave the key path empty to disable new deposits.
# The verifier co-signs verified return payouts; it cannot spend without the owner.
# Keep the key file outside source control, readable only by the API process.
# One deployment serves one network: devnet, testnet, mainnet or localnet.
REWARD_NETWORK=devnet
REWARD_RPC_URL=https://api.devnet.solana.com
REWARD_VERIFIER_KEYPAIR=
# Public address only; its private key should not be present on the API server.
REWARD_TREASURY=
# 500 = 5%. Accepted range: 1..1000 (0.01%..10%).
REWARD_FEE_BPS=500
# Comma-separated private key paths retained only while older reservations use them.
REWARD_LEGACY_VERIFIER_KEYPAIRS=
# Non-mainnet test mints only. See scripts/devnet-rewards.mjs and REWARDS.md.
REWARD_TEST_USDC_MINT=
REWARD_TEST_SKR_MINT=
# Mainnet needs a separate reviewed deployment and deliberate activation.
REWARDS_ALLOW_MAINNET=false
